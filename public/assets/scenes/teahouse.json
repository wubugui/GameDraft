    {
      "id": "teahouse_notice",
      "type": "inspect",
      "x": 54.9,
      "y": 192.8,
      "interactionRange": 64.3,
      "label": "告示板",
      "data": {
        "text": "告示板上贴着几张旧启事，大多是招工、寻人和催债。最上头一张红纸写得扎眼：\"近日夜里少往城隍庙方向去，若闻怪声，切勿停步。\"",
        "actions": [
          {
            "type": "collectClue",
            "params": {
              "clueId": "houshan_sangeng"
            }
          }
        ]
      }
    },
    {
      "id": "teahouse_table_items",
      "type": "inspect",
      "x": 428.6,
      "y": 431.6,
      "interactionRange": 57.1,
      "label": "桌上的茶碗",
      "data": {
        "text": "几个粗瓷茶碗摆得东倒西歪，花生壳和瓜子皮堆在一处。屋里人多，偏偏让人觉得越热闹越藏得住闲话。"
      }
    },
    {
      "id": "teahouse_door_too_early",
      "type": "inspect",
      "x": 164.7,
      "y": 170.8,
      "interactionRange": 20.0,
      "conditions": [
        {
          "not": {
            "narrative": "flow_xungou_main",
            "state": "state_2",
            "reached": true
          }
        }
      ],
      "label": "门口",
      "data": {
        "text": "门板虚掩，街上的雾气顺着门缝往里钻。身后醒木一响，满堂茶客都伸长了脖子——书正说到要紧处，这时候哪个舍得起身走人。"
      }
    },
