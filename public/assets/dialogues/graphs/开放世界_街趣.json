{
  "schemaVersion": 1,
  "id": "开放世界_街趣",
  "entry": "stall",
  "meta": {
    "title": "小钩、糖画与认字"
  },
  "nodes": {
    "end": {
      "type": "end"
    },
    "hook": {
      "type": "switch",
      "cases": [
        {
          "condition": {
            "narrative": "flow_ow_ring_hook",
            "state": "carrying",
            "reached": true
          },
          "next": "hook_empty"
        },
        {
          "condition": {
            "posture": "crouch"
          },
          "next": "hook_take"
        }
      ],
      "defaultNext": "hook_hint"
    },
    "hook_hint": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "[tag:string:owStreetPlay:hook_hint]",
      "next": "hook_accept"
    },
    "hook_accept": {
      "type": "runActions",
      "actions": [
        {
          "type": "emitNarrativeSignal",
          "params": {
            "signal": "ow_ring_accept"
          }
        },
        {
          "type": "setFocusedQuest",
          "params": {
            "id": "ow_ring_hook"
          }
        }
      ],
      "next": "end"
    },
    "hook_take": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "[tag:string:owStreetPlay:hook_take]",
      "next": "hook_commit"
    },
    "hook_commit": {
      "type": "runActions",
      "actions": [
        {
          "type": "emitNarrativeSignal",
          "params": {
            "signal": "ow_ring_take"
          }
        },
        {
          "type": "setFocusedQuest",
          "params": {
            "id": "ow_ring_hook"
          }
        }
      ],
      "next": "end"
    },
    "hook_empty": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "[tag:string:owStreetPlay:hook_empty]",
      "next": "end"
    },
    "child_hook": {
      "type": "switch",
      "cases": [
        {
          "condition": {
            "narrative": "flow_ow_ring_hook",
            "state": "done",
            "reached": true
          },
          "next": "hook_returned"
        },
        {
          "condition": {
            "flag": "has_item_ow_ring_hook"
          },
          "next": "hook_return_choice"
        }
      ],
      "defaultNext": "child_request"
    },
    "child_request": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "小满"
      },
      "text": "[tag:string:owStreetPlay:child_request]",
      "next": "child_accept"
    },
    "child_accept": {
      "type": "runActions",
      "actions": [
        {
          "type": "emitNarrativeSignal",
          "params": {
            "signal": "ow_ring_accept"
          }
        },
        {
          "type": "setFocusedQuest",
          "params": {
            "id": "ow_ring_hook"
          }
        }
      ],
      "next": "end"
    },
    "hook_return_choice": {
      "type": "choice",
      "options": [
        {
          "id": "return_hook",
          "text": "[tag:string:owStreetPlay:return_hook]",
          "next": "hook_return"
        },
        {
          "id": "keep_hook",
          "text": "[tag:string:owStreetPlay:keep_hook]",
          "next": "end"
        }
      ]
    },
    "hook_return": {
      "type": "runActions",
      "actions": [
        {
          "type": "emitNarrativeSignal",
