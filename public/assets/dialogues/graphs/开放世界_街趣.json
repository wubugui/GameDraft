    },
    "witness_choice": {
      "type": "choice",
      "options": [
        {
          "id": "follow_coat",
          "text": "[tag:string:owStreetPlay:follow_coat]",
          "next": "coat_handoff"
        },
        {
          "id": "witness_leave",
          "text": "[tag:string:owStreetPlay:witness_leave]",
          "next": "end"
        }
      ]
    },
    "coat_handoff": {
      "type": "runActions",
      "actions": [
        {
          "type": "emitNarrativeSignal",
          "params": {
            "signal": "ow_coat_accept"
          }
        },
        {
          "type": "setFocusedQuest",
          "params": {
            "id": "ow_coat"
          }
        }
      ],
      "next": "end"
    },
    "stall": {
      "type": "switch",
      "cases": [
        {
          "condition": {
            "any": [
              {
                "narrative": "flow_ow_sugar",
                "state": "given",
                "reached": true
              },
              {
                "narrative": "flow_ow_sugar",
                "state": "eaten",
                "reached": true
              }
            ]
          },
          "next": "stall_finished"
        },
        {
          "condition": {
            "not": {
              "narrative": "flow_ow_sugar_shape",
              "state": "initial"
            }
          },
          "next": "sugar_holding"
        },
        {
          "condition": {
            "not": {
              "all": [
                {
                  "flag": "minutes_of_day",
                  "op": ">=",
                  "value": 420
                },
                {
                  "flag": "minutes_of_day",
                  "op": "<",
                  "value": 1080
                }
              ]
            }
          },
          "next": "stall_closed"
        }
      ],
      "defaultNext": "stall_intro"
    },
    "stall_intro": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "糖画摊主"
      },
      "text": "[tag:string:owStreetPlay:stall_intro]",
      "next": "stall_accept"
    },
    "stall_accept": {
      "type": "runActions",
      "actions": [
        {
          "type": "emitNarrativeSignal",
