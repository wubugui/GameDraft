            "signal": "ow_ring_return"
          }
        }
      ],
      "next": "hook_returned"
    },
    "hook_returned": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "小满"
      },
      "text": "[tag:string:owStreetPlay:hook_returned]",
      "next": "child_menu"
    },
    "child_sugar": {
      "type": "switch",
      "cases": [
        {
          "condition": {
            "narrative": "flow_ow_sugar",
            "state": "given",
            "reached": true
          },
          "next": "child_got_sugar"
        },
        {
          "condition": {
            "flag": "has_item_ow_sugar_prize"
          },
          "next": "sugar_offer"
        }
      ],
      "defaultNext": "child_sugar_none"
    },
    "child_sugar_none": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "小满"
      },
      "text": "[tag:string:owStreetPlay:child_sugar_none]",
      "next": "child_menu"
    },
    "sugar_offer": {
      "type": "choice",
      "options": [
        {
          "id": "sugar_give",
          "text": "[tag:string:owStreetPlay:sugar_give]",
          "next": "sugar_give"
        },
        {
          "id": "sugar_keep",
          "text": "[tag:string:owStreetPlay:sugar_keep]",
          "next": "child_menu"
        }
      ]
    },
    "sugar_give": {
      "type": "runActions",
      "actions": [
        {
          "type": "emitNarrativeSignal",
          "params": {
            "signal": "ow_sugar_give"
          }
        }
      ],
      "next": "child_got_sugar"
    },
    "child_got_sugar": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "小满"
      },
      "text": "[tag:string:owStreetPlay:child_got_sugar]",
      "next": "child_menu"
    },
    "child_menu": {
      "type": "choice",
      "options": [
        {
          "id": "ask_witness",
          "text": "[tag:string:owStreetPlay:ask_witness]",
          "next": "child_witness",
          "requireCondition": {
            "any": [
              {
                "narrative": "flow_ow_ring_hook",
                "state": "done",
                "reached": true
              },
              {
                "narrative": "flow_ow_sugar",
                "state": "given",
                "reached": true
              }
            ]
          },
          "disabledClickHint": "[tag:string:owStreetPlay:ask_witness_disabled]"
        },
        {
          "id": "child_done",
          "text": "[tag:string:owStreetPlay:child_done]",
          "next": "end"
        }
      ]
    },
    "child_witness": {
      "type": "switch",
      "cases": [
        {
          "condition": {
            "not": {
              "any": [
                {
                  "narrative": "flow_ow_ring_hook",
                  "state": "done",
                  "reached": true
                },
                {
                  "narrative": "flow_ow_sugar",
                  "state": "given",
                  "reached": true
                }
              ]
            }
          },
          "next": "child_wont"
        },
        {
          "condition": {
            "narrative": "flow_ow_child_witness",
            "state": "heard",
            "reached": true
          },
          "next": "witness_again"
        }
      ],
      "defaultNext": "witness_line"
    },
    "child_wont": {
      "type": "line",
      "speaker": {
        "kind": "literal",
