        {
          "type": "setFocusedQuest",
          "params": {
            "id": "ow_sugar"
          }
        }
      ],
      "next": "stall_choices"
    },
    "stall_choices": {
      "type": "choice",
      "options": [
        {
          "id": "play_sugar",
          "text": "[tag:string:owStreetPlay:play_sugar]",
          "next": "play",
          "requireCondition": {
            "any": [
              {
                "not": {
                  "narrative": "flow_ow_sugar_payment",
                  "state": "initial"
                }
              },
              {
                "flag": "has_item_ow_sugar_ticket"
              },
              {
                "flag": "coins",
                "op": ">=",
                "value": 1
              }
            ]
          },
          "disabledClickHint": "[tag:string:owStreetPlay:play_sugar_disabled]"
        },
        {
          "id": "sugar_later",
          "text": "[tag:string:owStreetPlay:sugar_later]",
          "next": "end"
        }
      ]
    },
    "play": {
      "type": "runActions",
      "actions": [
        {
          "type": "startSugarWheelMinigame",
          "params": {
            "id": "ow_sugar"
          }
        }
      ],
      "next": "after_play"
    },
    "after_play": {
      "type": "switch",
      "cases": [
        {
          "condition": {
