            }
          },
          "next": "sugar_holding"
        },
        {
          "condition": {
            "not": {
              "narrative": "flow_ow_sugar_payment",
              "state": "initial"
            }
          },
          "next": "sugar_paid"
        }
      ],
      "defaultNext": "sugar_not_paid"
    },
