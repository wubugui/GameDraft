{
  "schemaVersion": 1,
  "id": "序章_街巷_夜遇癞子",
  "entry": "open",
  "meta": {
    "title": "序章·夜里撞见癞子：他还在老地方等那张铺（zone 一次性）"
  },
  "defaultLayout": "top",
  "nodes": {
    "open": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "next": "q_face",
      "lines": [
        {
          "speaker": {
            "kind": "literal",
            "name": "旁白"
          },
          "text": "街上黑得很。灯就那么几盏，灯与灯当中全是黑的。"
        },
        {
          "speaker": {
            "kind": "literal",
            "name": "旁白"
          },
          "text": "关二狗贴到墙根往回走。他脑壳头在编：明天啷个说。"
        },
        {
          "speaker": {
            "kind": "literal",
            "name": "旁白"
          },
          "text": "拐过弯，那两步路上有个人。走到头，掉头，又走回来。"
        },
        {
          "speaker": {
            "kind": "player"
          },
          "text": "……",
          "portrait": {
            "emotion": "calm"
          }
        },
        {
          "speaker": {
            "kind": "literal",
            "name": "旁白"
          },
          "text": "他往后退了半步。"
        },
        {
          "speaker": {
            "kind": "npc"
          },
          "text": "二哥！"
        },
        {
          "speaker": {
            "kind": "literal",
            "name": "旁白"
          },
          "text": "退不脱咯。"
        },
        {
          "speaker": {
            "kind": "npc"
          },
          "text": "我等到起的。"
        },
        {
          "speaker": {
            "kind": "npc"
          },
          "text": "二哥，那个铺……"
        },
        {
          "speaker": {
            "kind": "player"
          },
          "text": "铺？",
          "portrait": {
            "emotion": "calm"
          }
        },
        {
          "speaker": {
            "kind": "npc"
          },
          "text": "你说今黑了请我睡张铺。"
        },
        {
          "speaker": {
            "kind": "literal",
            "name": "旁白"
          },
          "text": "关二狗身上一文都没得。就那一枚，谁都不要的那一枚。"
        }
      ],
      "text": "街上黑得很。灯就那么几盏，灯与灯当中全是黑的。"
    },
    "q_face": {
      "type": "choice",
      "promptLine": {
        "speaker": {
          "kind": "literal",
          "name": "旁白"
        },
        "text": "癞子站到那点等他答话。"
      },
      "options": [
        {
          "id": "own",
          "text": "〔认了：老子输完了〕",
          "next": "b_own"
        },
        {
          "id": "cover",
          "text": "〔遮过去：钱在身上没得动〕",
          "next": "b_cover"
        },
        {
          "id": "turn",
          "text": "〔反问：你站好久咯〕",
          "next": "b_turn"
        }
      ]
    },
    "b_own": {
      "type": "line",
      "speaker": {
        "kind": "player"
      },
      "next": "join",
      "lines": [
        {
          "speaker": {
            "kind": "player"
          },
          "text": "……老子输完咯。",
          "portrait": {
            "emotion": "calm"
          }
        },
        {
          "speaker": {
            "kind": "npc"
          },
          "text": "哦。"
        },
        {
          "speaker": {
            "kind": "literal",
            "name": "旁白"
          },
          "text": "癞子就哦了一声。他没得追问，也没得怪。"
        },
        {
          "speaker": {
            "kind": "literal",
            "name": "旁白"
          },
          "text": "关二狗宁肯他骂两句。"
        }
      ],
      "text": "……老子输完咯。"
    },
    "b_cover": {
      "type": "line",
      "speaker": {
        "kind": "player"
      },
      "next": "join",
      "lines": [
        {
          "speaker": {
            "kind": "player"
          },
          "text": "钱在身上，没得动。",
          "portrait": {
            "emotion": "smirk"
          }
