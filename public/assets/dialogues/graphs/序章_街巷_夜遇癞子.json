        "kind": "player"
      },
      "next": "join",
      "lines": [
        {
          "speaker": {
            "kind": "player"
          },
          "text": "你站这点好久咯？",
          "portrait": {
            "emotion": "calm"
          }
        },
        {
          "speaker": {
            "kind": "npc"
          },
          "text": "天黑就在咯。"
        },
        {
          "speaker": {
            "kind": "npc"
          },
          "text": "二哥你说了在这点。"
        },
        {
          "speaker": {
            "kind": "literal",
            "name": "旁白"
          },
          "text": "关二狗把话咽回去了。"
        }
      ],
      "text": "你站这点好久咯？"
    },
