        {
          "speaker": {
            "kind": "npc"
          },
          "text": "……哦。"
        },
        {
          "speaker": {
            "kind": "literal",
            "name": "旁白"
          },
          "text": "癞子看了一眼他扯烂的那半边衣裳，没得说话。"
        }
      ],
      "text": "钱在身上，没得动。"
    },
