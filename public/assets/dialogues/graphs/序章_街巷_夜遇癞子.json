    "b_alone": {
      "type": "line",
      "speaker": {
        "kind": "player"
      },
      "next": "refuse",
      "lines": [
        {
          "speaker": {
            "kind": "player"
          },
          "text": "你在这点等到起。老子切去就回。",
          "portrait": {
            "emotion": "smirk"
          }
        },
        {
          "speaker": {
            "kind": "npc"
          },
          "text": "二哥。"
        },
        {
          "speaker": {
            "kind": "npc"
          },
          "text": "你莫去。"
        },
        {
          "speaker": {
            "kind": "player"
          },
          "text": "啷个又是这句。",
          "portrait": {
            "emotion": "angry"
          }
        }
      ],
      "text": "你在这点等到起。老子切去就回。"
    },
