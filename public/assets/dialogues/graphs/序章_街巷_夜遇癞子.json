      "lines": [
        {
          "speaker": {
            "kind": "player"
          },
          "text": "铺算啥子。",
          "portrait": {
            "emotion": "smirk"
          }
        },
        {
          "speaker": {
            "kind": "player"
          },
          "text": "老子等哈就把钱拿回来。",
          "portrait": {
            "emotion": "laugh"
          }
        },
        {
          "speaker": {
            "kind": "player"
          },
          "text": "义庄还有二百五！",
          "portrait": {
            "emotion": "laugh"
          }
        },
        {
          "speaker": {
            "kind": "npc"
          },
          "text": "……"
        },
        {
          "speaker": {
            "kind": "literal",
            "name": "旁白"
          },
          "text": "话一出口就收不回去咯。"
        }
      ],
      "text": "铺算啥子。"
    },
