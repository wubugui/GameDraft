    "meal": {
      "type": "switch",
      "cases": [
        {
          "condition": {
            "narrative": "flow_ow_meal",
            "state": "done",
            "reached": true
          },
          "next": "meal_done"
        },
        {
          "condition": {
            "narrative": "flow_ow_meal",
            "state": "carrying"
          },
          "next": "meal_have"
        },
        {
          "condition": {
            "not": {
              "any": [
                {
                  "all": [
                    {
                      "narrative": "flow_ow_stove",
                      "state": "repaired",
                      "reached": true
                    },
                    {
                      "all": [
                        {
                          "flag": "minutes_of_day",
                          "op": ">=",
                          "value": 420
                        },
                        {
                          "flag": "minutes_of_day",
                          "op": "<",
                          "value": 1320
                        }
                      ]
                    }
                  ]
                },
                {
                  "all": [
                    {
                      "not": {
                        "narrative": "flow_ow_stove",
                        "state": "repaired",
                        "reached": true
                      }
                    },
                    {
                      "all": [
                        {
                          "flag": "minutes_of_day",
                          "op": ">=",
                          "value": 420
                        },
                        {
                          "flag": "minutes_of_day",
                          "op": "<",
                          "value": 1200
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "next": "meal_closed"
