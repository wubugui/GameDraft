{
  "schemaVersion": 1,
  "id": "生态_荒庙香客",
  "entry": "root",
  "meta": {
    "title": "荒庙香客（枯井土地庙上香的婆子：按身体/时辰三选一；零阻塞、零信号）"
  },
  "nodes": {
    "root": {
      "type": "switch",
      "cases": [
        {
          "conditions": [
            {
              "flag": "player_health",
              "op": "<=",
              "value": 30
            }
          ],
          "next": "shang1"
        },
        {
          "conditions": [
            {
              "timePhase": "午"
            }
          ],
          "next": "wu1"
        }
      ],
      "defaultNext": "chen1"
    },
    "chen1": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "婆子"
      },
      "text": "初一十五我都来。庙塌成这个样子，土地公还是土地公。",
      "next": "chen2"
    },
    "chen2": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "她把三根香往香灰里一插，插得笔直。手抖，香不抖。",
      "next": "end"
    },
    "wu1": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "婆子"
      },
      "text": "井是啥子时候枯的？我记不得咯。只晓得枯了以后，这一片就没得人住咯。",
      "next": "act_wu"
    },
    "act_wu": {
      "type": "runActions",
      "actions": [
        {
          "type": "faceEntity",
          "params": {
            "target": "eco_kj_野狗",
            "direction": "right"
          }
        },
        {
          "type": "playNpcAnimation",
          "params": {
            "target": "eco_kj_野狗",
            "state": "bark",
            "loop": false,
            "thenState": "slow_walk",
            "speed": 1.2
          }
        }
      ],
      "next": "wu2"
    },
    "wu2": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "野狗朝井那头叫了两声。婆子头都没抬。",
      "next": "end"
    },
    "shang1": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "婆子"
      },
      "text": "后生，你脸白得像烧过的纸。跪一哈嘛——跪一哈不吃亏。",
      "next": "shang2"
    },
    "shang2": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "她往边上挪了半个身位，把蒲团那块地方让出来。",
      "next": "end"
    },
    "end": {
      "type": "end"
    }
  }
}
