    "l_wu": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "蹲了一气。日头爬过林梢，贴着水面那层雾散咯，滩上的鸭子挪到浅处去咯。",
      "next": "act"
    },
    "l_mu": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "再蹲一气。日头偏西，水变了颜色。对门林子里头，有个东西动了一下——看不清。",
      "next": "act"
    },
    "l_ye": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "天说黑就黑。滩上一个活物都不剩，只剩水响。",
      "next": "act"
    },
    "l_chen": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "靠着路坎眯了一觉。天麻麻亮，露水把裤脚打湿咯，鸭子已经下水咯。",
      "next": "act"
    },
    "act": {
      "type": "runActions",
      "actions": [
        {
          "type": "emitNarrativeSignal",
