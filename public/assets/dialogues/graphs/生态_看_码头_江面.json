      "actions": [
        {
          "type": "faceEntity",
          "params": {
            "target": "eco_dk_栈桥狗",
            "faceTarget": "player"
          }
        },
        {
          "type": "playNpcAnimation",
          "params": {
            "target": "eco_dk_栈桥狗",
            "state": "bark",
            "loop": false,
            "thenState": "idle",
            "speed": 1.25
          }
        }
      ],
      "next": "end"
    },
    "ye1": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "夜里的水看不出深浅，只听得到桩子底下咕咚咕咚，像有人蹲在下头拍板板。",
      "next": "act_ye"
    },
    "act_ye": {
      "type": "runActions",
      "actions": [
        {
          "type": "playNpcAnimation",
          "params": {
            "target": "eco_dk_栈桥狗",
            "state": "bark",
            "loop": false,
            "thenState": "idle",
            "speed": 1.45
          }
        }
      ],
      "next": "end"
    },
    "bs1": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "背起这个东西看水。水面上照出来的影子，多咯一个脑壳。",
      "next": "end"
    },
    "end": {
      "type": "end"
    }
