    "ri1": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "水是浑的，打起旋往下走。旋里翻上来一只烂草鞋，转两转又沉下去咯。",
      "next": "act_ri"
    },
    "act_ri": {
