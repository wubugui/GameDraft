    "l_wu": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "在缆桩上蹲咯一气。日头爬过对岸，船一条接一条挤进来咯。",
      "next": "act"
    },
    "l_mu": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "又蹲一气。日头偏西，栈桥上的号子声散咯一半。",
      "next": "act"
    },
    "l_ye": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "天说黑就黑。江面上只剩几点灯，一漂一漂的。",
      "next": "act"
    },
    "l_chen": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "眯咯一觉。江雾还没散，头一条船的橹声已经在响咯。",
      "next": "act"
    },
