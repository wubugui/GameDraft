      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "门边一口水缸，缸沿豁了个口。水面浮着一层灰，灰上头划开一道新口子——刚有人舀过。",
      "next": "act_first"
    },
    "night": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "缸里的水黑得看不到底。你的影子浮在上头，比你矮一截。",
      "next": "end"
    },
    "deep": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "缸底垫着一块碎瓦，瓦上压着一撮头发。老辈人说缸里压发，是防水里头有东西照人。",
      "next": "end"
    },
    "act_first": {
      "type": "runActions",
      "actions": [
        {
          "type": "showSpeechBubble",
          "params": {
            "target": "eco_wj_面摊_陈嬢嬢",
            "text": "那缸水是人家屋头的，莫舀。",
            "duration": 2600
          }
        }
      ],
