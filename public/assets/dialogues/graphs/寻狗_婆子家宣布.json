            "sourceId": "寻狗_婆子家宣布",
            "signal": "pozi_paid_half"
          }
        },
        {
          "type": "emitNarrativeSignal",
          "params": {
            "sourceType": "dialogue",
            "sourceId": "寻狗_婆子家宣布",
            "signal": "pozi_paid"
          }
        }
      ],
      "next": "n4"
    },
    "pay_blind": {
      "type": "line",
      "speaker": {
        "kind": "sceneNpc",
        "npcId": "npc_院中婆子"
      },
      "text": "……平了就好，平了就好。钱在这儿。你走嘛。",
      "next": "pay_blind_a",
      "portrait": {
        "emotion": "calm"
      }
    },
    "pay_blind_a": {
      "type": "runActions",
      "actions": [
        {
          "type": "giveCurrency",
          "params": {
            "amount": 10
          }
        },
        {
          "type": "emitNarrativeSignal",
          "params": {
            "sourceType": "dialogue",
            "sourceId": "寻狗_婆子家宣布",
            "signal": "pozi_paid_blind"
          }
        },
        {
          "type": "emitNarrativeSignal",
          "params": {
            "sourceType": "dialogue",
            "sourceId": "寻狗_婆子家宣布",
            "signal": "pozi_paid"
          }
        }
      ],
      "next": "n4"
    },
    "n4": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "院里安静了一瞬。风向变了一变——狗不叫了，鸡窝里也没了响动。谁也没看见什么。旁人只看见：道士来了，事就平了。",
      "next": "n6"
    },
    "n6": {
      "type": "line",
      "speaker": {
        "kind": "player"
      },
      "text": "（攥着铜钱，手心发烫）来钱……龟儿子，硬是撇脱。",
      "next": "n7",
      "portrait": {
        "emotion": "laugh"
      }
    },
    "n7": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "当夜，他没走大路，绕河滩回城——倒不是怂。是稳妥。行吧，是怂。",
      "next": "end1"
    },
    "end1": {
      "type": "end"
    }
  }
