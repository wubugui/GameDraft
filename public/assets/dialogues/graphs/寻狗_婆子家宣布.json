            "signal": "pozi_paid"
          }
        }
      ],
      "next": "luck_note"
    },
    "luck_note": {
      "type": "line",
      "speaker": {
        "kind": "player"
      },
      "text": "（成咯。……可老子到现在也说不上来，刚才那一下为啥就成了。）",
      "next": "n4",
      "portrait": {
        "emotion": "calm"
      }
    },
    "pay_half": {
      "type": "line",
      "speaker": {
        "kind": "sceneNpc",
        "npcId": "npc_院中婆子"
      },
      "text": "……哦。那，那就好。小先生辛苦咯，这点你先拿到起。",
      "next": "pay_half_a",
      "portrait": {
        "emotion": "calm"
      }
    },
    "pay_half_a": {
      "type": "runActions",
      "actions": [
