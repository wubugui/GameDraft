      "next": "pay_blind"
    },
    "pay_clean": {
      "type": "line",
      "speaker": {
        "kind": "sceneNpc",
        "npcId": "npc_院中婆子"
      },
      "text": "灵了！硬是灵了！！小先生——钱你收好！我去跟街坊说切！",
      "next": "pay_clean_a",
      "portrait": {
        "emotion": "laugh"
      }
    },
    "pay_clean_a": {
