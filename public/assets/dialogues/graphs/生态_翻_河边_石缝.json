    "first": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "石缝里塞着一把干草，压得实实的——挑水的歇脚，垫过屁股。草底下还压着半截烧过的香。",
      "next": "act"
    },
    "deep": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "香根是新的，插过的地方三个小孔，一样深浅。有人隔些日子就来这河边上一回香：不是路过，是还愿，要不就是赔罪。",
      "next": "act_deep"
    },
    "night": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "夜里摸那石缝，指头先碰到一手冰凉的湿灰。香灰是湿的——今黑才有人来过。",
      "next": "act_night"
    },
    "act": {
      "type": "runActions",
      "actions": [
        {
          "type": "playNpcAnimation",
          "params": {
            "target": "eco_hb_鸭乙",
            "state": "slow_walk",
