    "ri1": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "乌篷船吃水很深，篷子底下盖起油布。船尾拴起一只小划子，一晃一晃。",
      "next": "act_ri"
    },
    "act_ri": {
      "type": "runActions",
      "actions": [
        {
          "type": "faceEntity",
          "params": {
            "target": "eco_dk_船工",
            "faceTarget": "player"
          }
        },
        {
          "type": "showSpeechBubble",
          "params": {
            "target": "eco_dk_船工",
            "text": "看啥子看，货没卸完，莫上来。",
            "duration": 2600
          }
        }
      ],
      "next": "end"
    },
    "ye1": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "船上黑起，只船头挂咯一盏马灯。灯底下坐起个人，不动。",
      "next": "end"
    },
    "bs1": {
      "type": "line",
      "speaker": {
        "kind": "literal",
        "name": "旁白"
      },
      "text": "背起这个东西走到船边，篷子底下有只手把油布往下压咯半尺。",
      "next": "end"
    },
    "end": {
      "type": "end"
    }
  }
