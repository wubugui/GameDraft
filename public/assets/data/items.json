[
  {
    "id": "copper_coins",
    "name": "铜钱",
    "type": "consumable",
    "icon": "/resources/runtime/images/icons/copper_coins.png",
    "description": "几文铜钱，在[tag:string:place:wujin]能买碗面。",
    "maxStack": 99
  },
  {
    "id": "taomu",
    "name": "桃木片",
    "type": "consumable",
    "description": "一小片桃木，据说能驱邪避凶。老辈人出门都爱带一块。",
    "buyPrice": 3,
    "maxStack": 10,
    "tags": [
      "辟邪"
    ],
    "use": {
      "label": "攥在手心",
      "conditions": [
        {
          "flag": "has_item_iron_box"
        }
      ],
      "disableHint": "手里没揣着犯忌讳的东西，攥它做啥子。",
      "consume": false,
      "resultText": "桃木片攥在手心里，硌得慌。怀里那个铁盒子还是那么沉——攥紧点，好歹心头有个着落。"
    }
  },
  {
    "id": "nuomi",
    "name": "糯米",
    "type": "consumable",
    "icon": "/resources/runtime/images/icons/nuomi.png",
    "description": "一把糯米，粘乎乎的。听说洒在不干净的东西上有奇效。",
    "buyPrice": 2,
    "maxStack": 10,
    "tags": [
      "辟邪"
    ]
  },
  {
    "id": "shaojiu",
    "name": "烧酒",
    "type": "consumable",
    "description": "一壶土烧酒，辣得很。既能壮胆，据说泼在邪物上也管用。",
    "buyPrice": 5,
    "maxStack": 5,
    "tags": [
      "辟邪",
      "引火"
    ],
    "use": {
      "label": "灌一口",
      "resultText": "一口下去，从喉咙一路烧到胃里。手抖是不抖了，就是脑壳有点晕。"
    }
  },
  {
    "id": "iron_box",
    "name": "铁盒子",
    "type": "key",
    "description": "瞎子李交给你的铁盒子。盒面摸上去光滑异常，明明不大，揣在怀里却总让人心里发毛。瞎子李特地叮嘱：七天之内，千万别打开。",
    "dynamicDescriptions": [
      {
        "conditions": [
          {
            "flag": "box_opened"
          }
        ],
        "text": "打开过的铁盒子，里面是……一面古旧的小铜镜。镜面模糊，照不出人影。"
      },
      {
        "conditions": [
          {
            "flag": "box_hidden_in_temple"
          }
        ],
        "text": "你已经把铁盒藏进了城隍庙。可自从离开那里以后，你总忍不住怀疑自己是不是藏错了地方。"
      }
    ],
    "maxStack": 1
  },
  {
    "id": "mugwort",
    "name": "艾草",
    "type": "consumable",
    "description": "一把晒干的艾草，点燃后烟气呛人。老人说挂在门上能辟邪。",
    "maxStack": 10,
    "tags": [
      "辟邪",
      "引火"
    ],
    "use": {
      "label": "点燃",
      "actions": [
        {
          "type": "showNotification",
          "params": {
            "text": "艾烟散开",
            "type": "info"
          }
        }
      ],
      "resultText": "火折子凑上去，干艾草噼啪着起了烟。青白的一股，呛得眼睛发酸，可这味道一上来，心口那点毛焦火辣倒是压下去了些。"
    }
  },
  {
    "id": "talisman",
    "name": "黄纸符",
    "type": "consumable",
    "icon": "/resources/runtime/images/icons/talisman.png",
    "description": "城东道士画的符，歪歪扭扭的，也不知道灵不灵。",
    "buyPrice": 8,
    "maxStack": 5,
    "tags": [
      "辟邪"
    ]
  },
  {
    "id": "temple_notes",
    "name": "庙祝手札",
    "type": "key",
    "icon": "/resources/runtime/images/icons/temple_notes.png",
    "description": "城隍庙庙祝留下的手札，上面记载着一些庙里的旧事和禁忌。字迹工整，看得出庙祝是个有学问的人。",
    "dynamicDescriptions": [
      {
        "conditions": [
          {
            "flag": "read_temple_notes"
          }
        ],
        "text": "庙祝手札里提到：庙后山本是义冢，安葬无主之骨。城隍镇百鬼，但义冢中有一坟，年年不长草，庙祝说那坟里的人'心有不甘'。"
      }
    ],
    "maxStack": 1
  },
  {
    "id": "iron_hoop",
    "name": "铁环",
    "type": "key",
    "description": "小孩滚着玩的铁环，摸着冰凉。",
    "maxStack": 1
  },
  {
    "id": "joss_paper",
    "name": "纸钱",
    "type": "consumable",
    "icon": "/resources/runtime/images/icons/joss_paper.png",
    "description": "河滩上那只手递来的纸钱，黄的、软的。用剩下这几张，扔也不是，留也不是。",
    "maxStack": 10,
    "tags": [
      "沾秽"
    ]
  },
  {
    "id": "heavy_bundle",
    "name": "沉甸甸的包袱",
    "type": "key",
    "icon": "/resources/runtime/images/icons/heavy_bundle.png",
    "description": "雇主交代送到阎王岭山口歇脚棚的包袱。死沉，棱角硌背。别问里头是啥——一问，工钱就没了。",
    "maxStack": 1
  },
  {
    "id": "daopao",
    "name": "旧道袍",
    "type": "key",
    "icon": "/resources/runtime/images/icons/daopao.png",
    "description": "当铺角落赊来的一件旧道袍，洗得发白，掌柜的懒得收。穿身上空荡荡的——可远看，有那么点意思。",
    "maxStack": 1
  },
  {
    "id": "luopan",
    "name": "锈罗盘",
    "type": "key",
    "description": "庙会摊上贱买的铜罗盘，指针锈得乱转。关二狗倒乐：“乱转才像撞着煞嘛。”",
    "buyPrice": 3,
    "maxStack": 1
  },
  {
    "id": "taomu_sword",
    "name": "桃木剑",
    "type": "key",
    "icon": "/resources/runtime/images/icons/taomu_sword.png",
    "description": "从城东先生那里顺来的桃木剑，轻得像烧火棍；外搭两张讹来的歪符——歪是歪，红是红，唬人够了。",
    "maxStack": 1
  },
  {
    "id": "taoist_outfit",
    "name": "凑合的行头",
    "type": "key",
    "icon": "/resources/runtime/images/icons/taoist_outfit.png",
    "description": "用零活攒的钱置办的一身「道士皮」：旧道袍、歪符、桃木剑。不全、不正经，但远看……还行。",
    "maxStack": 1
  },
  {
    "id": "silver_dimes",
    "name": "银角子",
    "type": "key",
    "icon": "/resources/runtime/images/icons/silver_dimes.png",
    "description": "埃德加塞过来的两枚银角子。说好的十块大洋呢？洋人的账，比僵尸还邪门。",
    "maxStack": 2
  },
  {
    "id": "old_cloth_pouch",
    "name": "旧帕子包",
    "type": "key",
    "icon": "/resources/runtime/images/icons/old_cloth_pouch.png",
    "description": "逃命路上贪财捡的一个旧帕子包，破帕子裹着几样没用的小物——铜亮纽子、半张洋烟盒纸、一个空香粉盒、几缕零线。对世人是垃圾，没舍得扔。揣上它，总有一缕散不掉的廉价香粉味跟着；夜里隐隐还有半句跑调的小调。每回他快没命，那味就陡然浓起来，像有什么盲目地不让他撒手。",
    "maxStack": 1
  },
  {
    "id": "juzi",
    "name": "橘子",
    "type": "consumable",
    "description": "顺手摸来的一个橘子，饿了能垫一垫。",
    "maxStack": 5,
    "tags": [
      "食物"
    ],
    "use": {
      "label": "吃掉",
      "resultText": "皮薄，掰开一股酸气。三两口下肚，肚皮里那点空总算被压住了。"
    }
  },
  {
    "id": "banbing",
    "name": "半个粗粮饼",
    "type": "consumable",
    "description": "从叫花子那儿抢来的半个饼，有点脏，好歹能咬两口。",
    "maxStack": 5,
    "tags": [
      "食物"
    ],
    "use": {
      "label": "吃掉",
      "resultText": "饼硬得硌牙，就着口水往下咽。噎是噎，到底是顶了饿。"
    }
  },
  {
    "id": "feiji",
    "name": "肥鸡",
    "type": "consumable",
    "description": "偷来的一只肥鸡，扑腾得厉害。烤了顶饱，卖了换钱。",
    "maxStack": 3
  },
