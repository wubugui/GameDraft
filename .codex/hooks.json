{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/scripts/py.sh\" \"${CLAUDE_PROJECT_DIR:-.}/agent_docs/_meta/hooks/paths_reminder.py\"",
            "timeout": 10,
            "statusMessage": "agent_docs 必读卡检查"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/scripts/py.sh\" \"${CLAUDE_PROJECT_DIR:-.}/scripts/agent_hooks/validation_gate.py\"",
            "timeout": 15,
            "statusMessage": "收尾验证门检查"
          }
        ]
      }
    ]
  }
}
