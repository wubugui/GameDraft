{
  "name": "gamedraft",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "vite",
    "build": "npm run package:release",
    "build:web-only": "tsc && vite build",
    "build:tools": "npm run build:narrative-editor",
    "manifest:release": "node scripts/pytool.cjs build.asset_manifest . --target release --report-unpicked",
    "manifest:dev": "node scripts/pytool.cjs build.asset_manifest . --target dev --report-unpicked",
    "package:dev": "tsc && node scripts/package.mjs --target dev",
    "package:release": "tsc && node scripts/package.mjs --target release",
    "verify:dev": "node scripts/verify_build.mjs --target dev",
    "verify:release": "node scripts/verify_build.mjs --target release",
    "release": "node scripts/release.mjs",
    "build:gui": "node scripts/pytool.cjs build_workbench .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run package:release && tauri build",
    "test:tauri": "cargo test --release --manifest-path src-tauri/Cargo.toml",
    "typecheck:narrative-editor": "tsc --noEmit -p tools/narrative_editor_web",
    "typecheck:anim-preview": "tsc --noEmit -p tools/anim_preview",
    "test:anim-preview": "node --test tools/anim_preview/*.test.mjs && vitest run tools/anim_preview/assemblyMath.test.ts",
    "build:narrative-editor": "npm run typecheck:narrative-editor && vite build --config tools/narrative_editor_web/vite.config.ts",
    "build:anim-preview-remote": "vite build --config tools/anim_preview/vite.remote.config.ts",
    "dev:narrative-editor": "vite --config tools/narrative_editor_web/vite.config.ts",
    "dev:anim-preview": "vite --config tools/anim_preview/vite.config.ts",
    "assemble:anim-preview-remote": "node tools/anim_preview/assemble_remote_deploy.mjs",
    "dev:parallax-editor": "vite --config tools/parallax_editor/vite.config.ts",
    "planner:gui": "node scripts/pytool.cjs production_workbench .",
    "preview": "vite preview",
    "filter-tool": "node scripts/pytool.cjs filter_tool",
    "test": "vitest run --exclude 'tools/anim_preview/*.test.mjs' && npm run test:anim-preview"
  },
  "type": "module",
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@xyflow/react": "^12.10.2",
    "elkjs": "^0.11.1",
    "gifenc": "^1.0.3",
    "howler": "^2.2.4",
    "pixi.js": "^8.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/howler": "^2.2.12",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  }
}
