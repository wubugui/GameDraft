# 仅忽略名为 .ts 的文件夹
**/.ts/
.ts/

# Dependencies and package manager
node_modules/
.tools/
.cache/
config/bootstrap-oss.json

# Build and cache
dist/
# 无锚定的 `build/` 会匹配**任意层级**上叫 build 的目录——包括打包管线自己的
# tools/build/（那是源码，必须入库）。锚到仓库根，再显式放行工具目录。
/build/
!tools/build/
coverage/
.vite/
# 打包管线的中间产物与产物根（抽取清单、staging、发行包）
.build/
release/
# Rust/Tauri 的编译产物（src-tauri 下的源码与配置要入库，target/ 不要）
src-tauri/target/
src-tauri/gen/
# 运行时持久化：存档、玩家设置、调试偏好。**不是游戏数据**，是这台机器上这一份进度。
local/
artifact/content_pipeline/
artifact/Experiments/
*.log
*.tmp
*.temp
*.cache

# OS / editor
.DS_Store
Thumbs.db

# workbuddy 本地状态
.workbuddy/

# Cursor 项目级配置需托管，勿忽略 .cursor/

# Python (tools)
__pycache__/
*.pyc
.Python
venv/
.venv/

# Env and secrets
.env
.env.local
.env.*.local

# 编年史模拟器：本地 LLM 密钥（由 private_llm_defaults.example.json 复制改名）
tools/chronicle_sim/data/private_llm_defaults.json
tools/chronicle_sim_v2/data/private_llm_defaults.json

# 编年史模拟器：本地运行产物（快照/数据库等可能含 llm_config 与 api_key）
tools/chronicle_sim/runs/
tools/chronicle_sim_v2/runs/
tools/chronicle_sim_v3/runs/

# 编年史 v3：根级 runs/ 真实测试数据（含 api_key 文件 / cline session / 子任务历史）
runs/

# 编年史 v3：cook 调试时的根级时间线落盘
_tl.json
*.tl.json

# 对话编译产物（源文件为 .ink）
public/assets/dialogues/*.ink.json

# Temp / read zip folder
_read_zip/

# 根目录 tmp：默认忽略，仅托管 chronicle 变异概率示意图
tmp/*
!tmp/chronicle_sim_mutation_probability/
!tmp/chronicle_sim_mutation_probability/**

# 宣传视频模板（克隆项目）
oss-video-skill/

# 编辑器本地状态（图布局等），非游戏数据，不入库
.editor/

# 本地资产备份目录：图片/中间结果较大，不入 Git，也不交给 DVC 管理
asset-backups/

# 项目接手引导独立 App（只读学习工具，不入库）
onboarding-app/

# 配音原始音源库：大文件、不可再生素材。不进 Git，改由 DVC 托管
# （见 resources/audio_sources.dvc，忽略规则在 resources/.gitignore），工具见 tools/voice_workbench

# artifact/ 整个目录留在本地,不进版本(制作人 2026-09-08 定):
# 这里放的是设计稿/盘点/评审报告/生成脚本与中间音频,属于工作过程,不是交付物。
# 交付用的音频在 public/resources/runtime/audio/ 下,由 DVC 管。
# 注:历史上已入库的那批(含脚步声 artifact/FootstepSFX_20260907/)不受影响——
# gitignore 管不到已跟踪的文件；要退版本得另行 git rm --cached。
artifact/

# 声学空间编辑器存盘时写的旧版备份，本地保留即可
public/assets/data/*.json.bak
