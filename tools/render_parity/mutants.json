[
  {
    "id": "lc-area-winding",
    "desc": "面光四角绕向反了(lcAreaLight 里 v1 / v3 对调)",
    "file": "[\\\\/]lightingCore\\.wgsl$",
    "edits": [
      { "from": "center - halfU + halfV,", "to": "center + halfU - halfV," },
      { "from": "center + halfU - halfV);", "to": "center - halfU + halfV);" }
    ],
    "cases": "光照片段 / LC|光照片段 / 实体灯循环"
  },
  {
    "id": "lc-area-pi",
    "desc": "面光辐照度的 1/2π 里 π 写成 3.13(差 0.37%;看 acos 放宽后的面光容差还抓不抓得住小错)",
    "file": "[\\\\/]lightingCore\\.wgsl$",
    "edits": [{ "from": "return sum * (0.5 / LC_PI);", "to": "return sum * (0.5 / 3.13);" }],
    "cases": "光照片段 / LC|光照片段 / 实体灯循环"
  },
  {
    "id": "clc-probe-bias",
    "desc": "probe 查询点的法线偏置反号(q + n·0.525·cellMin → q − …)",
    "file": "[\\\\/]charLightCommon\\.wgsl$",
    "edits": [{ "from": "q + n * (0.525 * cellMin)", "to": "q - n * (0.525 * cellMin)", "all": true }],
    "cases": "光照片段 / CLC|光照片段 / PROBE"
  },
  {
    "id": "esl-two-sided",
