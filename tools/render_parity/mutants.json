    "edits": [{ "from": "(flags & 2) != 0, 1.0);", "to": "(flags & 1) != 0, 1.0);", "all": true }],
    "cases": "光照片段 / 实体灯循环"
  },
  {
    "id": "wr-ppu",
    "desc": "q → 像素的 ppu 偏 1e-3(相对 2e-6,~2000 处约 4~8 个 f32 ulp;看 WR 的 1 ulp 放宽还抓不抓得住)",
